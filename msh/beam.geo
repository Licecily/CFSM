// ---------------------------- 参数 ----------------------------
L = 3.0;     // 梁长
n = 10;      // 单元段数（取偶数可保证跨中恰好落在节点上，便于加集中力）

// ---------------------- 几何：一条直线 ------------------------
Point(1) = {0, 0, 0};    // 左端（固定端）
Point(2) = {0, 0, L};    // 右端（固定端）
Line(1) = {1, 2};

// --------------- 网格：线上布 n+1 个节点 ⇒ n 个 SEG2 单元 ---------------
Transfinite Curve{1} = n + 1;

// ---------------------------- 物理组 ----------------------------
// 命令名决定维数：Physical Point → dim 0，Physical Curve → dim 1；
// 等号右边 {} 里是几何实体编号（Point(1)、Point(2) 的编号），不是坐标或节点号。
Physical Curve("Ω") = {1};        // 梁轴线（计算域，线性 SEG2 单元）
Physical Point("Γ¹") = {1};       // 左端（固定端，dim 0）
Physical Point("Γ²") = {2};       // 右端（固定端，dim 0）

// ---------------------------- 输出 ----------------------------
Mesh.ElementOrder = 1;       // 线性单元 ⇒ 两节点 SEG2
Mesh.MshFileVersion = 4.1;   
Mesh 1;                     
Save "beamZ.msh";
